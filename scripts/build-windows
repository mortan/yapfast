#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."
# The Discord flavour is the release; full adds Matrix, as a separate preview.
# Arguments after the flavour go to scripts/package-windows.py, such as
# --no-installer.
flavour=${1:-discord}
# Its Cargo features, one per line, from release_package.py's FLAVOURS.
if ! listed=$(python3 -c 'import sys; sys.path.insert(0, "scripts"); from release_package import FLAVOURS
print(*FLAVOURS[sys.argv[1]]["features"], sep="\n")' "$flavour" 2>/dev/null); then
  echo "usage: scripts/build-windows [discord|full] [package-windows.py options]" >&2
  exit 2
fi
features=()
while IFS= read -r feature; do
  if [[ -n "$feature" ]]; then features+=("$feature"); fi
done <<<"$listed"
shift $(($# > 0 ? 1 : 0))
rustup target add x86_64-pc-windows-msvc
mkdir -p "$PWD/.local/windows"
yapfast_skia_archive=$(python3 nix/prepare-windows-skia.py)
export SKIA_BINARIES_URL="file://$yapfast_skia_archive"
# cargo-xwin's environment, with source paths that name no folder here.
source scripts/release-env x86_64-pc-windows-msvc
cargo build --locked --release --target x86_64-pc-windows-msvc "${features[@]}"
python3 scripts/package-windows.py --flavour "$flavour" "$@"
