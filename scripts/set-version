#!/usr/bin/env bash
# Sets Yapfast's version in Cargo.toml and Cargo.lock, as the nightly release
# does before building: `scripts/set-version 0.2.0-nightly.20261020.5`.
# The app, the packages' names and SOURCE.txt's release link all take it. A
# stable version also goes into the Arch PKGBUILD, which builds its tag, and
# into the metainfo's releases, dated today: `scripts/set-version 0.2.0`
# before committing and tagging v0.2.0. The README names no version, so
# nothing else needs changing.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."
version=${1:?usage: scripts/set-version VERSION}
# Cargo takes only SemVer; a prerelease's numeric parts can't start with 0.
number='(0|[1-9][0-9]*)' part='(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)'
if ! [[ $version =~ ^$number\.$number\.$number(-$part(\.$part)*)?$ ]]; then
  echo "scripts/set-version: $version isn't a SemVer version" >&2
  exit 2
fi
# Replaces the lines of FILE that match PATTERN, a Python regular expression,
# with REPLACEMENT, or only the first COUNT of them: sed's in-place editing
# and first-match address differ between GNU and macOS.
replace() {
  python3 -c 'import re, sys
from pathlib import Path
path, pattern, replacement, count = Path(sys.argv[1]), sys.argv[2], sys.argv[3], int(sys.argv[4])
text = path.read_text(encoding="utf-8")
path.write_text(re.sub(pattern, replacement, text, count=count, flags=re.MULTILINE), encoding="utf-8")' \
    "$1" "$2" "$3" "${4:-0}"
}
# The package's version is the manifest's first; the lockfile's follows its name.
replace Cargo.toml '^version = .*' "version = \"$version\"" 1
replace Cargo.lock '^(name = "yapfast"\nversion = ).*' "\\g<1>\"$version\""
# A pkgver can't hold a prerelease's "-", and nightlies don't build from a tag.
if [[ $version != *-* ]]; then
  replace packaging/arch/PKGBUILD '^pkgver=.*' "pkgver=$version"
  replace packaging/arch/PKGBUILD '^pkgrel=.*' pkgrel=1
  metainfo=packaging/linux/io.github.yapfast.Yapfast.metainfo.xml
  if ! grep -q "<release version=\"$version\"" "$metainfo"; then
    replace "$metainfo" '^  <releases>$' "\\g<0>\n    <release version=\"$version\" date=\"$(date +%F)\"/>"
  fi
fi
