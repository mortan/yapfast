#!/usr/bin/env bash
# Builds Yapfast.app for Apple silicon into target/dist/Yapfast.app, and its
# ZIP, source snapshot and SHA256SUMS.txt into target/dist/macos/FLAVOUR: a
# release build with source paths that name no folder here
# (scripts/release-env), packed by scripts/package-macos.py.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."
# The Discord flavour is the release; full adds Matrix, as a separate preview.
# --dev builds the measure profile instead, optimized as release but
# incremental, so that the app is ready seconds after a small edit: for trying
# it here, not for release; its package goes to target/dist/macos/FLAVOUR-dev,
# with -dev in its names.
# Later arguments go to scripts/package-macos.py.
flavour=${1:-discord}
# Its Cargo features, one per line, from release_package.py's FLAVOURS.
if ! listed=$(python3 -c 'import sys; sys.path.insert(0, "scripts"); from release_package import FLAVOURS
print(*FLAVOURS[sys.argv[1]]["features"], sep="\n")' "$flavour" 2>/dev/null); then
  echo "usage: scripts/build-macos [discord|full] [--dev] [package-macos.py options]" >&2
  exit 2
fi
features=()
while IFS= read -r feature; do
  if [[ -n "$feature" ]]; then features+=("$feature"); fi
done <<<"$listed"
shift $(($# > 0 ? 1 : 0))
profile=release
if [ "${1:-}" = --dev ]; then
  profile=measure
  # Its symbols would name the object files' folders here.
  export CARGO_PROFILE_MEASURE_STRIP=true
  shift
fi
source scripts/macos-env
source scripts/release-env aarch64-apple-darwin
# macOS's bash 3.2 calls an empty array unbound under `set -u`.
cargo build --locked --profile "$profile" --target aarch64-apple-darwin ${features[@]+"${features[@]}"}
python3 scripts/package-macos.py --flavour "$flavour" --profile "$profile" "$@"
