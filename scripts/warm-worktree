#!/usr/bin/env bash
# Gives a new worktree the main checkout's build, so its first build compiles
# the crates in this repository instead of every dependency.
# Usage: scripts/warm-worktree, inside the worktree, before its first build.
# It copies target/fast and target/check-combinations with reflinks, which
# take no space until the copies diverge, and skips one the worktree already
# has. It needs a filesystem with reflinks, such as btrfs, or APFS clones.
# The copies keep their timestamps: Cargo rebuilds a crate whose
# dependencies look newer.
# It also copies the private material .gitignore keeps out of the repository.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

source scripts/dev-shell

main=$(git worktree list --porcelain | sed -n '1s/^worktree //p')
if [[ "$main" == "$PWD" ]]; then
  echo "scripts/warm-worktree: run it inside a worktree, not the main checkout" >&2
  exit 2
fi

# The crates whose sources are in the repository: the workspace and vendor/.
# Cargo would reuse their copied builds, and a build script that names its
# inputs by absolute path, as Slint's does, would go on watching the main
# checkout's files. Cleaning them makes them build from this worktree's.
# A loop rather than mapfile, which macOS's bash 3.2 lacks.
local_crates=()
while IFS= read -r line; do
  local_crates+=("$line")
done < <(cargo metadata --locked --format-version 1 |
  jq -r '.packages[] | select(.source == null) | "-p\n\(.name)"')

# Reflinks, as macOS's cp makes them: APFS clones.
reflink=(--reflink=always) reflink_auto=(--reflink=auto)
if [[ $(uname) == Darwin ]]; then
  reflink=(-c) reflink_auto=(-c)
fi

mkdir -p target
# Cargo cleans only a target directory that has this tag, which the main
# checkout's may lack, so it's written here as Cargo writes it.
if [[ ! -e target/CACHEDIR.TAG ]]; then
  printf '%s\n' 'Signature: 8a477f597d28d172789f06886806bc55' \
    '# This file is a cache directory tag created by cargo.' \
    '# For information about cache directory tags see https://bford.info/cachedir/' \
    >target/CACHEDIR.TAG
fi
for dir in fast check-combinations; do
  if [[ ! -d "$main/target/$dir" ]]; then
    echo "$dir: the main checkout has none"
    continue
  fi
  if [[ -e "target/$dir" ]]; then
    echo "$dir: already here"
    continue
  fi
  if ! cp -a "${reflink[@]}" "$main/target/$dir" "target/$dir.partial"; then
    rm -rf "target/$dir.partial"
    echo "scripts/warm-worktree: could not reflink $main/target/$dir" >&2
    exit 1
  fi
  mv "target/$dir.partial" "target/$dir"
  # target/fast is the fast profile of target/; scripts/check builds
  # target/check-combinations/fast.
  target_dir=target
  [[ "$dir" == fast ]] || target_dir=target/$dir
  cargo clean --profile fast --target-dir "$target_dir" "${local_crates[@]}"
  echo "$dir: copied from $main"
done

# The private material .gitignore keeps out of the repository, which work in a
# worktree may still read, such as DESIGN.md: each entry of that section,
# copied from the main checkout unless the worktree has it.
sed -n '/^# Private working material/,/^$/p' .gitignore | grep '^/' | while read -r entry; do
  for source in "$main"${entry%/}; do
    path=${source#"$main"/}
    [[ -e "$source" && ! -e "$path" ]] || continue
    mkdir -p "$(dirname "$path")"
    cp -a "${reflink_auto[@]}" "$source" "$path"
  done
done
echo "private material: copied from $main"
